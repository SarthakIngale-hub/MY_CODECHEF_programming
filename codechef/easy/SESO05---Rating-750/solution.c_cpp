#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<pair<int, int>> pairs(n);
    for (int i = 0; i < n; i++) {
        cin >> pairs[i].first >> pairs[i].second;
    }
    
    int a, b;
    cin >> a >> b;
    
    bool found = false;
    for (int i = 0; i < n; i++) {
        int x = pairs[i].first;
        int y = pairs[i].second;

        if ((x == a && y == b) || (x == b && y == a)) {
            found = true;
            break; 
        }
    }
    
    if (found) {
        cout << "Yes" << endl;
    } else {
        cout << "No" << endl;
    }
    
    return 0;
}
