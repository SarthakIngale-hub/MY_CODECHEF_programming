#include <bits/stdc++.h>
using namespace std;

bool linear_search(int arr[],int n,int k){
    for(int i=0;i<n;i++){
        if(arr[i] == k){
            return true;
        }
    }
    return false;
}

int main() {
	// your code goes here
    int n;
    int k;
    cin>>n;
    cin>>k;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    if(linear_search(arr,n,k)) cout<<"Yes";
    else cout<<"No";
}
