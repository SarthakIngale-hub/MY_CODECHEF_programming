#include <bits/stdc++.h>
using namespace std;

int main() {

    int array[] = {3, 5, 2, 9, 7, 1};
    int length = sizeof(array) / sizeof(array[0]);
    bool found = false;

    for (int i = 0; i < length; ++i) {
        if (array[i] == 7) {
            found = true;
            break;
        }
    }

    if (found) {
        cout << "Yes" << endl;
    } else {
        cout << "No" << endl;
    }

    return 0;
}
